ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
DEFAULT_TEAM=Karmine Corp
# Public key sent by the lolesports.com website (x-api-key header of its API calls).
LOLESPORTS_API_KEY=0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z
# Optional: Leaguepedia bot credentials (Special:BotPasswords), for higher rate limits.
LEAGUEPEDIA_BOT_USERNAME=
LEAGUEPEDIA_BOT_PASSWORD=
# Optional: path of the local SQLite database (default: esport_agent.db).
# SQLITE_PATH=esport_agent.db
# Optional: lolesports leagues to sync, as a JSON list of slugs.
# LOLESPORTS_LEAGUES=["lec", "lfl", "worlds", "msi", "first_stand"]
# Optional: time zone used for match times and today's date (default: Europe/Paris).
# TIMEZONE=Europe/Paris
# Optional: leagues (lolesports slugs, by priority) used to pick a team from a short name.
# PREFERRED_LEAGUES=["lec"]
# Optional: log level (DEBUG, INFO, WARNING, ERROR). Default: INFO for the sync, WARNING for the CLI.
# LOG_LEVEL=INFO
# Optional: also write logs to this file, rotated at 5 MB.
# LOG_FILE=logs/esport_agent.log
# Optional: Leaguepedia page names for teams the sync cannot match on its own (see the sync logs).
# LEAGUEPEDIA_TEAM_ALIASES={"Team Liquid Alienware": "Team Liquid"}
